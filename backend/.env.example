# GMGN API Key - NEVER expose this to frontend
GMGN_API_KEY=gmgn_34e908c29b76b5de762cbedebc8bda7e

# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@host:5432/gmgn_bot

